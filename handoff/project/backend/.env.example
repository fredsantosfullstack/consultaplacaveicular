# Database Configuration (KingHost MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=goldenveicular

# JWT Secret (gere uma string aleatória longa e segura)
JWT_SECRET=seu_segredo_jwt_super_secreto_aqui

# Server Port
PORT=3001

# URL do Frontend (para configuração do CORS)
# Em desenvolvimento: http://localhost:5174
# Em produção: a URL do seu site. Pode ser uma lista separada por vírgulas.
FRONTEND_URL=http://localhost:5174

