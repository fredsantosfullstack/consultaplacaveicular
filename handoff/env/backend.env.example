# Backend – Golden Veicular
# Copie este arquivo para backend/.env e ajuste os valores

# --- Banco de Dados MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_usuario_mysql
DB_PASSWORD=sua_senha_mysql
DB_NAME=goldenveicular

# --- Autenticação ---
JWT_SECRET=alterar_para_chave_segura
PORT=3001
FRONTEND_URL=http://localhost:5174

# --- Integração API Externa de Consultas ---
API_BASE_URL=https://portaldespachantes.online
API_ACCESS_KEY=sua_chave_de_acesso

# --- Integração ASAAS ---
ASAAS_ENV=sandbox
ASAAS_API_KEY=sua_chave_asaas

# --- SMTP (opcional) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
