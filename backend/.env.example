# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=consultaplacaveicular

# JWT Secret (gere uma string aleatória longa e segura)
JWT_SECRET=seu_segredo_jwt_super_secreto_aqui_mude_isso

# Server Port
PORT=3001

# URLs
FRONTEND_URL=http://localhost:5174
BACKEND_URL=http://localhost:3001

# API Externa - Portal Despachantes
API_ACCESS_KEY=sua_chave_api_aqui

# Mercado Pago (obtenha em: https://www.mercadopago.com.br/developers)
# Deixe vazio para configurar pelo painel admin
MERCADO_PAGO_ACCESS_TOKEN=

# SMTP Configuration (opcional - para emails de contato)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_app
